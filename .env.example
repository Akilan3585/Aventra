# Copy this file to .env.local, then replace every value ending in _REPLACE_ME.
# Never commit .env.local. Do not put a secret in any NEXT_PUBLIC_ variable.

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk (required when Clerk authentication is enabled)
# Clerk Dashboard -> Configure -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"
# Clerk Dashboard -> Developers -> Webhooks -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET="whsec_REPLACE_ME"

# Supabase (required now)
# Supabase Dashboard -> Project -> Connect -> Next.js
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Server-only. Do not expose this key in the browser or in a NEXT_PUBLIC_ variable.
# Keep blank until a server-only administrative job actually needs it.
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"

# AI provider (set AI_PROVIDER to openai or gemini when the AI features are enabled)
AI_PROVIDER="openai"

# OpenAI (required only when AI_PROVIDER=openai)
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk_REPLACE_ME"
# Leave blank until the AI provider integration selects a production model.
OPENAI_MODEL=""

# Google Gemini (required only when AI_PROVIDER=gemini)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIza_REPLACE_ME"
# Leave blank until the AI provider integration selects a production model.
GEMINI_MODEL=""
