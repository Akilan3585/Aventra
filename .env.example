# Copy this file to .env.local, then replace every value ending in _REPLACE_ME.
# Never commit .env.local. Do not put a secret in any NEXT_PUBLIC_ variable.

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk
# Clerk Dashboard -> Configure -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"
# Comma-separated emails that receive initial super-admin access.
CAMPUS_ADMIN_EMAILS="admin@your-campus.edu"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Clerk Dashboard -> Developers -> Webhooks
# Endpoint: https://YOUR_DOMAIN/api/webhooks/clerk
# Subscribe to: user.created and user.updated
CLERK_WEBHOOK_SIGNING_SECRET="whsec_REPLACE_ME"

# Supabase
# Supabase Dashboard -> Project -> Connect -> Next.js
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Server-only. Never expose this key in the browser.
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"

# AI provider: openai or gemini
AI_PROVIDER="openai"

# OpenAI
OPENAI_API_KEY="sk_REPLACE_ME"
OPENAI_MODEL=""

# Google Gemini
GEMINI_API_KEY="AIza_REPLACE_ME"
GEMINI_MODEL=""
